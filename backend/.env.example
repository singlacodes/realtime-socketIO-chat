PORT=8000
MONGODB_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/realtimeChat
JWT_SECRET=your_jwt_secret

# Public backend URL (required on Render for local image fallback)
SERVER_URL=https://your-backend.onrender.com

# Frontend origin(s), comma-separated
CLIENT_URL=http://localhost:5173,https://realtime-socketio-chat-mgz8.onrender.com

# Set true if frontend and backend are on different hosts (cross-site cookies)
CROSS_SITE_COOKIES=true

# Cloudinary — API key must have CREATE/upload permission
CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret
